{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@core/*": ["./core/*"],
      "@clients/*": ["./clients/*"]
    }
  },
  "include": ["core", "clients", "scripts", "playwright.config.ts"]
}
