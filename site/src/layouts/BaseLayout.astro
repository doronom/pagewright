---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = site.description, image, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('/rss.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Applies the saved theme, or the system setting, before first paint.
      (function () {
        const stored = (function () {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="bg-bg text-body-md text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-chip focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="container-page flex flex-grow flex-col gap-10 py-10" data-test="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { setupThemeToggle } from '../lib/client/theme';
      import { setupCopyButtons } from '../lib/client/copy';
      setupThemeToggle();
      setupCopyButtons();
    </script>
  </body>
</html>
