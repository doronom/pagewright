---
import Icon from './Icon.astro';

interface Props {
  type?: 'note' | 'tip' | 'warning';
  /** Category label shown above the text; defaults to the type. */
  title?: string;
}

const { type = 'note', title } = Astro.props;
const config = {
  note: { icon: 'info', color: 'var(--secondary)' },
  tip: { icon: 'check_circle', color: 'var(--primary)' },
  warning: { icon: 'warning', color: 'var(--tertiary)' },
} as const;
const { icon, color } = config[type];
---

<aside
  class="callout not-prose rounded-r-card border border-l-[3px] border-border p-6"
  style={`--accent: ${color};`}
  data-test="callout"
  data-test-type={type}
>
  <p class="mb-1 flex items-center gap-2 font-mono text-label-sm font-bold uppercase" style="color: var(--accent);">
    <Icon name={icon} size={16} />
    <span>[{title ?? type}]</span>
  </p>
  <div class="text-body-md text-muted [&>*+*]:mt-3"><slot /></div>
</aside>

<style>
  .callout {
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface-low));
  }
</style>
