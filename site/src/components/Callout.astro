---
import Icon from './Icon.astro';

interface Props {
  type?: 'note' | 'tip' | 'warning';
  /** Category label shown above the text; defaults to the type. */
  title?: string;
}

const { type = 'note', title } = Astro.props;
const config = {
  note: { icon: 'info', color: 'var(--secondary)' },
  tip: { icon: 'check_circle', color: 'var(--primary)' },
  warning: { icon: 'warning', color: 'var(--tertiary)' },
} as const;
const { icon, color } = config[type];
---

<aside
  class="callout not-prose rounded-r-card border border-l-4 p-6"
  style={`--accent: ${color};`}
  data-test="callout"
  data-test-type={type}
>
  <p class="mb-1 flex items-center gap-2 font-mono text-label-sm font-bold uppercase" style="color: var(--accent);">
    <Icon name={icon} size={16} />
    <span>[{title ?? type}]</span>
  </p>
  <div class="text-body-md text-muted [&>*+*]:mt-3"><slot /></div>
</aside>

<style>
  .callout {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    border-left-color: var(--accent);
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--accent) 12%, var(--surface-low)),
      var(--surface-low) 45%,
      var(--surface-low)
    );
    box-shadow: 0 10px 30px -20px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .callout :global(svg) {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent));
  }
</style>
