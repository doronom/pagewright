---
import Icon from './Icon.astro';
import { href } from '../lib/url';
import { formatDate } from '../lib/format';
import { formatDuration, loadTestSummary } from '../lib/testSummary';

// Renders only when the site's own test run produced a summary. Every number comes from that file.
const summary = loadTestSummary();
---

{
  summary && (
    <section
      class="glass-card flex flex-wrap items-center justify-between gap-4 p-4"
      data-test="suite-telemetry"
    >
      <div class="flex flex-wrap items-center gap-4 font-mono text-label-sm text-muted">
        <span class="chip rounded-pill px-2.5 py-1 text-success bg-[var(--tint-success)] border-[color-mix(in_srgb,var(--success)_35%,transparent)]" data-test="telemetry-passed">
          <Icon name="done_all" size={14} />
          {summary.passed} passed
        </span>
        <span class="text-border" aria-hidden="true">•</span>
        <span class:list={['chip rounded-pill px-2.5 py-1', summary.failed > 0 ? 'text-error bg-[var(--tint-error)]' : 'text-primary tint-cyan']} data-test="telemetry-failed">
          <Icon name={summary.failed > 0 ? 'error' : 'check_circle'} size={14} />
          {summary.failed} failed
        </span>
        <span class="text-border" aria-hidden="true">•</span>
        <span class="chip rounded-pill px-2.5 py-1 text-primary tint-cyan" data-test="telemetry-duration">
          <Icon name="timer" size={14} />
          {formatDuration(summary.durationMs)}
        </span>
        <span class="text-border" aria-hidden="true">•</span>
        <span class="chip rounded-pill px-2.5 py-1 text-secondary tint-violet" data-test="telemetry-date">
          <Icon name="schedule" size={14} />
          {formatDate(new Date(summary.date))}
        </span>
      </div>
      <a href={href('/testing/')} class="chip px-2.5 py-1 text-primary tint-cyan transition-colors hover:border-primary">
        <span>How this site is tested</span>
        <Icon name="arrow_forward" size={14} />
      </a>
    </section>
  )
}
