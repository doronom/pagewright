---
import CodeBlock from './CodeBlock.astro';
import { assertSnippetContains, readRepoLines, validateHighlight } from '../lib/repo';

interface Props {
  /** Path relative to the repository root, e.g. "core/page/DynamicPage.ts". */
  file: string;
  /** "N" or "N-M". Omit to include the whole file. */
  lines?: string;
  /** Lines to highlight, using the file's line numbers: "64,66-68". */
  highlight?: string;
  lang?: string;
  /** Exact text the quoted range must contain. Fails the build when the range has drifted. */
  match?: string;
}

const { file, lines, highlight, lang, match } = Astro.props;
const snippet = readRepoLines(file, lines);
assertSnippetContains(snippet, match);
const highlightLines = validateHighlight(highlight, snippet);
const label = lines ? `${snippet.file}:${snippet.startLine}-${snippet.endLine}` : snippet.file;
---

<div data-test="repo-code" data-test-file={snippet.file}>
  <CodeBlock
    code={snippet.code}
    lang={lang ?? snippet.lang}
    file={label}
    startLine={snippet.startLine}
    highlight={highlightLines}
    repoUrl={snippet.url}
  />
</div>
