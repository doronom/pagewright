---
import Icon from './Icon.astro';

interface Props {
  test?: string;
}

const { test = 'theme-toggle' } = Astro.props;
---

<button
  type="button"
  class="inline-flex items-center justify-center rounded-chip border border-transparent p-1.5 text-muted transition-colors hover:border-border hover:bg-surface-low hover:text-primary"
  data-test={test}
  data-theme-toggle
  aria-label="Toggle theme"
>
  <Icon name="dark_mode" class="theme-icon-dark" />
  <Icon name="light_mode" class="theme-icon-light" />
</button>
