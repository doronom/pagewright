---
import Icon from './Icon.astro';

interface Props {
  test?: string;
}

const { test = 'theme-toggle' } = Astro.props;
---

<button
  type="button"
  class="inline-flex items-center justify-center rounded-chip border p-2 text-primary transition-colors tint-cyan hover:border-primary"
  data-test={test}
  data-theme-toggle
  aria-label="Toggle theme"
>
  <Icon name="dark_mode" class="theme-icon-dark" />
  <Icon name="light_mode" class="theme-icon-light" />
</button>
