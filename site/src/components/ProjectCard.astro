---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Terminal from './Terminal.astro';
import { href } from '../lib/url';
import { seriesForProject, type Project } from '../lib/content';

interface Props {
  project: Project;
  variant?: 'compact' | 'expanded';
}

const { project, variant = 'compact' } = Astro.props;
const { data } = project;
const series = await seriesForProject(project);
const Heading = variant === 'expanded' ? 'h2' : 'h3';
---

<article
  class="flex w-full flex-col justify-between rounded-card border border-border bg-surface-low p-6"
  data-test="project-card"
  data-test-id={project.id}
  data-test-variant={variant}
  id={variant === 'expanded' ? project.id : undefined}
>
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2">
      <Icon name="inventory_2" class="text-primary" />
      <Heading class="text-headline-md font-bold text-text">{data.title}</Heading>
    </div>
    <p class="text-body-md text-muted">{data.summary}</p>
    {
      variant === 'expanded' && data.features.length > 0 && (
        <ul class="flex flex-col gap-2 text-body-sm text-muted" data-test="project-features">
          {data.features.map((feature) => (
            <li class="flex gap-2">
              <Icon name="check" size={18} class="mt-0.5 text-primary" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      )
    }
    <Terminal commands={data.quickStart} label="quick start" />
  </div>
  <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-border pt-6">
    <Button href={data.repoUrl} variant="secondary" icon="folder_code" external test="project-repo">Repository</Button>
    {
      series && (
        <Button href={href(`/series/${series.id}/`)} iconAfter="arrow_forward" test="project-deep-dive">
          Deep dive
        </Button>
      )
    }
  </div>
</article>
