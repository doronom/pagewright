---
interface Props {
  title: string;
  test?: string;
}

const { title, test = 'empty-state' } = Astro.props;
---

<div
  class="rounded-card border border-dashed border-border bg-surface-low p-10 text-center"
  data-test={test}
>
  <p class="font-mono text-label-md text-faint uppercase">{title}</p>
  <div class="mt-2 text-body-sm text-muted"><slot /></div>
</div>
