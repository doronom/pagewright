---
import SeriesProgress from './SeriesProgress.astro';
import { href } from '../lib/url';
import type { SeriesStatus } from '../lib/content';

interface Props {
  status: SeriesStatus;
}

const { status } = Astro.props;
const { series, published } = status;
---

<article
  class="group relative flex flex-col gap-4 rounded-card border border-border bg-surface-low p-6 transition-colors hover:border-border-strong"
  data-test="series-card"
  data-test-id={series.id}
>
  <p class="font-mono text-label-sm text-muted">
    <span class="chip text-tertiary">SERIES</span>
    <span class="ml-2">{published} of {series.data.plannedParts} published</span>
  </p>
  <h2 class="text-headline-md text-text transition-colors group-hover:text-primary">
    <a href={href(`/series/${series.id}/`)} class="after:absolute after:inset-0">{series.data.title}</a>
  </h2>
  <p class="text-body-sm text-muted">{series.data.summary}</p>
  <SeriesProgress published={published} planned={series.data.plannedParts} />
</article>
