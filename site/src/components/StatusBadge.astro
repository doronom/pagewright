---
export type Status = 'passed' | 'failed' | 'flaky' | 'running' | 'published' | 'coming-soon';

interface Props {
  status: Status;
  label?: string;
  pulse?: boolean;
  uppercase?: boolean;
}

const { status, label, pulse = false, uppercase = true } = Astro.props;
// DESIGN.md "Pass/Fail Pipeline Status Chips": tinted pills; passed is green, failed and flaky are coral.
const tone = {
  passed: 'text-success bg-[var(--tint-success)] border-[color-mix(in_srgb,var(--success)_35%,transparent)]',
  published: 'text-primary tint-cyan',
  failed: 'text-error bg-[var(--tint-error)] border-[color-mix(in_srgb,var(--error)_35%,transparent)]',
  flaky: 'text-error bg-[var(--tint-error)] border-[color-mix(in_srgb,var(--error)_35%,transparent)]',
  'coming-soon': 'text-tertiary tint-amber',
  running: 'text-secondary tint-violet',
}[status];
const defaultLabel = { 'coming-soon': 'Coming soon' }[status as 'coming-soon'] ?? status;
---

<span
  class:list={['chip whitespace-nowrap rounded-pill px-2.5 py-1 font-semibold', uppercase && 'uppercase', tone]}
  data-test="status-badge"
  data-test-status={status}
>
  <span class="relative inline-flex size-2" aria-hidden="true">
    {pulse && <span class="absolute inline-flex size-full animate-ping rounded-pill bg-current opacity-60" />}
    <span class="relative inline-flex size-2 rounded-pill bg-current"></span>
  </span>
  <span>{label ?? defaultLabel}</span>
</span>
