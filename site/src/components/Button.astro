---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: IconName;
  iconAfter?: IconName;
  external?: boolean;
  test?: string;
}

const { href, variant = 'primary', icon, iconAfter, external = false, test } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-chip border px-6 py-3 font-mono text-label-md font-semibold transition-all duration-200',
    variant === 'primary'
      ? 'btn-gradient border-transparent hover:scale-[1.02]'
      : 'border-[var(--accent-cyan)] bg-surface-low/80 text-text hover:border-primary hover:shadow-[var(--glow)]',
  ]}
  data-test={test ?? `btn-${variant}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {icon && <Icon name={icon} size={16} />}
  <span><slot /></span>
  {iconAfter && <Icon name={iconAfter} size={16} />}
</a>
