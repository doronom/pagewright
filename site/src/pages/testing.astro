---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { formatDate } from '../lib/format';
import { githubTreeUrl, githubUrl } from '../lib/repo';
import { getPage } from '../lib/content';
import { mdxComponents } from '../lib/mdxComponents';
import { formatDuration, loadTestSummary } from '../lib/testSummary';

const page = await getPage('testing');
const { Content } = await render(page);
const summary = loadTestSummary();
const stats = summary
  ? [
      { label: 'Passed', value: String(summary.passed), test: 'stat-passed' },
      { label: 'Failed', value: String(summary.failed), test: 'stat-failed' },
      { label: 'Skipped', value: String(summary.skipped), test: 'stat-skipped' },
      { label: 'Duration', value: formatDuration(summary.durationMs), test: 'stat-duration' },
    ]
  : [];
const links = [
  { label: 'Site tests', url: githubTreeUrl('site/tests'), test: 'link-site-tests' },
  { label: 'Playwright config', url: githubUrl('site/playwright.config.ts'), test: 'link-playwright-config' },
  { label: 'Deploy workflow', url: githubUrl('.github/workflows/deploy-site.yml'), test: 'link-deploy-workflow' },
];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="flex flex-col gap-2">
    <h1 class="text-headline-xl-mobile text-text sm:text-headline-xl" data-test="page-title">{page.data.title}</h1>
    <p class="max-w-[75ch] text-body-lg text-muted">{page.data.description}</p>
  </header>

  {
    summary && (
      <section class="flex flex-col gap-4 glass-card p-6" data-test="test-results">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-headline-sm text-text">Latest run</h2>
          <div class="flex items-center gap-3 font-mono text-label-sm text-muted">
            <StatusBadge status={summary.failed > 0 ? 'failed' : 'passed'} />
            <span data-test="stat-date">{formatDate(new Date(summary.date))}</span>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map((s) => (
            <div class="rounded-chip border border-border bg-surface p-4" data-test={s.test}>
              <dt class="font-mono text-label-sm uppercase text-faint">{s.label}</dt>
              <dd class="mt-1 font-mono text-headline-md text-text">{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
    <div class="prose lg:col-span-8" data-test="testing-body"><Content components={mdxComponents} /></div>
    <aside class="lg:col-span-4">
      <section class="flex flex-col gap-3 glass-card accent-violet p-6" data-test="test-code-links">
        <h2 class="font-mono text-label-sm uppercase text-faint">Test code</h2>
        <ul class="flex flex-col gap-2">
          {links.map((l) => (
            <li>
              <a href={l.url} class="inline-flex items-center gap-1.5 text-body-md text-muted hover:text-primary" target="_blank" rel="noopener noreferrer" data-test={l.test}>
                <span>{l.label}</span>
                <Icon name="open_in_new" size={14} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
