{
  "name": "pagewright-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:drafts": "SITE_DRAFTS=1 astro build --outDir dist-drafts",
