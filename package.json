{
  "name": "pagewright",
  "version": "1.0.0",
  "private": true,
  "description": "Client-extendable Playwright + TypeScript automation template",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "new-client": "tsx scripts/new-client.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "axios": "^1.20.0",
    "dotenv": "^18.0.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.5.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "allure-playwright": "^3.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
